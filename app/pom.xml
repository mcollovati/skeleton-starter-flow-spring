<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>addon-csp-fallback</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>app</artifactId>
    <name>Application that uses the ACME add-on with vaadin.contentSecurityPolicy=strict</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>acme-addon</artifactId>
        </dependency>

        <!-- Real add-ons from the Vaadin Directory, used by the views in
             org.vaadin.example.ecosystem (released versions) -->
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>viritin</artifactId>
            <version>3.9.1</version>
        </dependency>
        <dependency>
            <groupId>com.wontlost</groupId>
            <artifactId>ckeditor-vaadin</artifactId>
            <version>6.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.vaadin.jchristophe</groupId>
            <artifactId>sortable-layout</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.parttio</groupId>
            <artifactId>hugerte-for-flow</artifactId>
            <version>2.3.0</version>
        </dependency>
        <dependency>
            <groupId>pl.unforgiven</groupId>
            <artifactId>superfields</artifactId>
            <version>0.21.2</version>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.vaadin.addons</groupId>
            <artifactId>enhanced-tabs-addon</artifactId>
            <version>1.2.2</version>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.vaadin.addons</groupId>
            <artifactId>twincolgrid</artifactId>
            <version>4.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.vaadin.addons</groupId>
            <artifactId>markdown-editor-addon</artifactId>
            <version>2.0.3</version>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.vaadin.addons</groupId>
            <artifactId>image-crop-addon</artifactId>
            <version>1.3.0</version>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.vaadin.addons</groupId>
            <artifactId>zoomist-addon</artifactId>
            <version>1.3.0</version>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.addons</groupId>
            <artifactId>xterm-console</artifactId>
            <version>3.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.vaadin.addons.flowingcode</groupId>
            <artifactId>year-month-calendar</artifactId>
            <version>4.6.2</version>
        </dependency>
        <dependency>
            <groupId>org.vaadin.addons.flowingcode</groupId>
            <artifactId>chat-assistant-addon</artifactId>
            <version>5.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.vaadin.addons.flowingcode</groupId>
            <artifactId>extended-login</artifactId>
            <version>1.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.vaadin.addons.chipfield</groupId>
            <artifactId>chipfield-addon</artifactId>
            <version>2.8.0</version>
        </dependency>
        <dependency>
            <groupId>com.flowingcode.vaadin.addons</groupId>
            <artifactId>orgchart-addon</artifactId>
            <version>5.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.vaadin.stefan</groupId>
            <artifactId>fullcalendar2</artifactId>
            <version>8.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.parttio</groupId>
            <artifactId>maplibre</artifactId>
            <version>2.1.1</version>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.64.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <!-- Some add-ons are only in the Vaadin Directory repository -->
        <repository>
            <id>vaadin-addons</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>it</id>
            <properties>
                <it.port>8080</it.port>
                <it.csp>strict</it.csp>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>start-spring-boot</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                                <configuration>
                                    <!-- Flow sends the CSP header only in production mode,
                                         so the tests run against the production bundle
                                         that build-frontend made -->
                                    <systemPropertyVariables>
                                        <vaadin.productionMode>true</vaadin.productionMode>
                                        <vaadin.launch-browser>false</vaadin.launch-browser>
                                    </systemPropertyVariables>
                                    <arguments>
                                        <argument>--server.port=${it.port}</argument>
                                        <argument>--vaadin.contentSecurityPolicy=${it.csp}</argument>
                                        <!-- Kept to read the bundle check errors of vaadin/flow#27078 -->
                                        <argument>--logging.file.name=${project.build.directory}/server.log</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stop-spring-boot</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Runs the integration tests (*IT) after the server is started -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <trimStackTrace>false</trimStackTrace>
                            <enableAssertions>true</enableAssertions>
                            <systemPropertyVariables>
                                <it.baseUrl>http://localhost:${it.port}</it.baseUrl>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>
</project>
