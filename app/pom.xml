<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>addon-csp-fallback</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>app</artifactId>
    <name>Application that uses the ACME add-on with vaadin.contentSecurityPolicy=strict</name>
    <packaging>jar</packaging>

    <properties>
        <!-- Set to true by the uses-fix profile -->
        <it.usesFix>false</it.usesFix>
        <!-- Set by the name-clash and rebuild-* profiles: adds
             src/${extra.cases}/java to the build. "none" does not exist -->
        <extra.cases>none</extra.cases>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>acme-addon</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.64.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-extra-cases</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/${extra.cases}/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>it</id>
            <properties>
                <it.port>8080</it.port>
                <it.csp>strict</it.csp>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>start-spring-boot</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                                <configuration>
                                    <!-- Flow sends the CSP header only in production mode,
                                         so the tests run against the production bundle
                                         that build-frontend made -->
                                    <systemPropertyVariables>
                                        <vaadin.productionMode>true</vaadin.productionMode>
                                        <vaadin.launch-browser>false</vaadin.launch-browser>
                                    </systemPropertyVariables>
                                    <arguments>
                                        <argument>--server.port=${it.port}</argument>
                                        <argument>--vaadin.contentSecurityPolicy=${it.csp}</argument>
                                        <!-- MissingDefinitionIT reads the server log -->
                                        <argument>--logging.file.name=${project.build.directory}/server.log</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stop-spring-boot</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Runs the integration tests (*IT) after the server is started -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <trimStackTrace>false</trimStackTrace>
                            <enableAssertions>true</enableAssertions>
                            <systemPropertyVariables>
                                <it.baseUrl>http://localhost:${it.port}</it.baseUrl>
                                <it.serverLog>${project.build.directory}/server.log</it.serverLog>
                                <it.usesFix>${it.usesFix}</it.usesFix>
                                <it.extraCases>${extra.cases}</it.extraCases>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Adds a route with @Uses(ReflectedJs.class), so the production
             bundle carries the definition that MissingDefinitionView calls
             through reflection -->
        <profile>
            <id>uses-fix</id>
            <properties>
                <it.usesFix>true</it.usesFix>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-uses-fix</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/uses-fix/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- A @JsStringFallback interface with @JsDefinitionImport, which is
             refused (vaadin/flow#27423). Kept out of the default build to
             see whether it affects the other fallbacks -->
        <profile>
            <id>fallback-import</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-fallback-import</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/fallback-import/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Reached definitions that import modules that do not exist
             (vaadin/flow#27424): MissingModuleView and MissingModuleIT.
             Kept out of the default build, which they stop today -->
        <profile>
            <id>missing-module</id>
            <properties>
                <extra.cases>missing-module</extra.cases>
            </properties>
        </profile>

        <!-- Review findings on vaadin/flow#27457 (see the README). Each one
             adds src/<id>/java -->
        <profile>
            <id>name-clash</id>
            <properties>
                <extra.cases>name-clash</extra.cases>
            </properties>
        </profile>
        <profile>
            <id>rebuild-query</id>
            <properties>
                <extra.cases>rebuild-query</extra.cases>
            </properties>
        </profile>
        <profile>
            <id>rebuild-jar-query</id>
            <properties>
                <extra.cases>rebuild-jar-query</extra.cases>
            </properties>
        </profile>
        <profile>
            <id>rebuild-no-extension</id>
            <properties>
                <extra.cases>rebuild-no-extension</extra.cases>
            </properties>
        </profile>

    </profiles>
</project>
